# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token

# Comma-separated Telegram user IDs allowed to use /stats and /ingest
ADMIN_IDS=123456789

# Storage (SQLite file for MVP; point DB_PATH elsewhere to move it)
DB_PATH=data/bot.db

# Default radar center and radius
DEFAULT_CITY=suzhou
DEFAULT_RADIUS_KM=30

# How often to poll sources for new events (minutes)
INGEST_INTERVAL_MIN=30

# Cities the ingestor scans (slugs from app/cities.py)
TRACKED_CITIES=suzhou,shanghai,hangzhou,wuxi,nanjing

# Optional: Meetup API token (https://secure.meetup.com/api/oauth/) enables the Meetup source
MEETUP_TOKEN=

# Optional: extra RSS feeds, separated by ; each as URL|city_slug
# RSS_FEEDS=https://www.meetup.com/.../rss|shanghai;https://example.com/events.xml|suzhou
RSS_FEEDS=

# Polite scraping: seconds between requests to the same host
MIN_REQUEST_INTERVAL_SEC=4
REQUEST_TIMEOUT=15

# Notify quiet hours (China time, UTC+8)
QUIET_START=22
QUIET_END=8
MAX_NOTIFY_PER_CYCLE=10

LOG_LEVEL=INFO
